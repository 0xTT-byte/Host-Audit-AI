[
  {
    "Id": "c3d4e5f6a7b8",
    "Name": "/vulnerable-db",
    "Config": {
      "User": "root"
    },
    "HostConfig": {
      "Privileged": true,
      "NetworkMode": "host",
      "CapAdd": [
        "SYS_ADMIN",
        "NET_ADMIN"
      ],
      "Binds": [
        "/var/run/docker.sock:/var/run/docker.sock:rw",
        "/etc:/host-etc:ro"
      ]
    },
    "Mounts": [
      {
        "Type": "bind",
        "Source": "/var/run/docker.sock",
        "Destination": "/var/run/docker.sock",
        "Mode": "rw",
        "RW": true
      },
      {
        "Type": "bind",
        "Source": "/etc",
        "Destination": "/host-etc",
        "Mode": "ro",
        "RW": false
      }
    ]
  }
]
